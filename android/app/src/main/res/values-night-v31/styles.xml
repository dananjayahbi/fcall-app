<?xml version="1.0" encoding="utf-8"?>
<!-- Night variant of the API 31+ splash. The app is dark-only in practice, so
     both modes resolve to the same surfaces; the file exists because
     values-night/ must supply a complete LaunchTheme or the system falls back
     to the light default for users in dark mode. -->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/launch_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/ic_launcher_background</item>
    </style>

    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
